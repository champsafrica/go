# Copy to .env and fill in. Every integration is optional: without it the app simulates
# that channel and records what it would have sent.
PORT=3000
# Go Rides uses the Go Ads domain for now.
SITE_URL=https://www.goads.co.za
# Database. Locally, a SQLite file. In production, a Turso database: on Vercel, add it
# from Storage > Marketplace > Turso, which sets these two for you.
DATABASE_PATH=./data/go-rides.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Protects /api/cron, which runs booking, reminders and renewals. Vercel Cron sends it
# automatically; any other scheduler must send "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Lets you create the first admin account at /setup on a new database. Remove it after.
SETUP_CODE=

# Payments (PayFast). Leave blank to use the built-in simulated checkout.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Notifications. Leave blank to simulate.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
CLICKATELL_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Go Rides <rides@goads.co.za>
